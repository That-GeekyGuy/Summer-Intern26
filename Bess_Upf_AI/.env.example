# Copy to .env and fill in all values before running.
# .env is gitignored — never commit real credentials.

# ── VictoriaMetrics ───────────────────────────────────────────────────────────
# Basic-auth credentials for the VictoriaMetrics HTTP API.
# Used by: Prometheus remote_write, export-job, and Caddy reverse-proxy auth.
VM_AUTH_USERNAME=vmadmin
VM_AUTH_PASSWORD=CHANGE_ME_strong_password_here

# Retention period in months (integer). 12 = 1 year.
VM_RETENTION=12

# ── Prometheus ────────────────────────────────────────────────────────────────
# How long Prometheus keeps data locally. Keep short — VM is the long-term store.
PROMETHEUS_RETENTION=24h

# Default scrape interval. Override per-job in prometheus.yml if needed.
PROMETHEUS_SCRAPE_INTERVAL=15s

# Host:port that VictoriaMetrics uses to federate metrics from Prometheus.
# Default works for the standard Docker Compose setup (service name + port).
# Change this if Prometheus is exposed on a different host or port, e.g.:
#   PROM_SCRAPE_TARGET=192.168.1.10:9090   (external Prometheus)
#   PROM_SCRAPE_TARGET=prom.internal:9090  (custom DNS)
PROM_SCRAPE_TARGET=prometheus:9090

# ── MinIO ─────────────────────────────────────────────────────────────────────
# Root (admin) credentials for the MinIO server.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password_here

# Least-privilege service account for the export job (read/write to EXPORT_BUCKET only).
# Created automatically by minio-init on first startup.
MINIO_EXPORTER_USER=upf-exporter
MINIO_EXPORTER_PASSWORD=CHANGE_ME_strong_password_here

# Name of the S3 bucket the export job writes Parquet files to.
EXPORT_BUCKET=upf-metrics

# ── Export job ────────────────────────────────────────────────────────────────
# Lookback window queried on each run. Default matches daily-at-02:00 schedule.
EXPORT_LOOKBACK=24h

# Comma-separated list of metric names to export. Must include upf_sim_scenario
# for Tier 2 ML ground-truth labels (the prepare_dataset.py script requires it).
EXPORT_METRICS=pfcp_sessions_total,port_bytes_count,port_packets_count,port_dropped_count,upf_sim_scenario

# Structured log level for the export job: debug | info | warn | error
LOG_LEVEL=info

# ── Caddy reverse proxy ────────────────────────────────────────────────────────
# Hostname Caddy will serve (used in TLS cert and virtual-host matching).
# For local dev, keep as "localhost". For production, set to your real FQDN.
CADDY_HOSTNAME=localhost

# Bcrypt hash of the password Caddy uses to gate access to the VictoriaMetrics
# and MinIO UIs over HTTPS. Generate with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your_password'
# The plaintext must match VM_AUTH_PASSWORD so Prometheus remote_write still works
# when routed through Caddy (if you choose that path later).
CADDY_ADMIN_USER=admin
CADDY_ADMIN_PASS_HASH=CHANGE_ME_run_caddy_hash-password

# ── TLS (dev only) ────────────────────────────────────────────────────────────
# Paths inside the Caddy container to the TLS certificate and key.
# For dev: generated by scripts/gen-dev-certs.sh (self-signed, clearly marked).
# For production: remove these and let Caddy auto-obtain via ACME (Let's Encrypt)
# by setting CADDY_HOSTNAME to a public FQDN and exposing ports 80/443.
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key

# ── Detection service ──────────────────────────────────────────────────────────
# Rules file is at config/detection/rules.yml (mounted into the container).
DETECTION_POLL_INTERVAL=60s
DETECTION_WINDOW=30m
DETECTION_RETENTION_DAYS=30

# ── LLM model server ──────────────────────────────────────────────────────────
# scripts/start.sh sets VLLM_MODEL / VLLM_MAX_MODEL_LEN automatically based on
# detected VRAM. Override here only if you want to force a specific config.
#
# GPU mode (docker-compose.gpu.yml):
#   VLLM_MODEL / VLLM_MAX_MODEL_LEN / VLLM_GPU_MEM_UTIL auto-selected by start.sh
#
# CPU mode (docker-compose.cpu.yml — Ollama):
#   OLLAMA_MODEL: model tag pulled from ollama.com (default: qwen2.5:3b)
#   OLLAMA_MEMORY_LIMIT / OLLAMA_CPU_LIMIT: resource caps for the Ollama container
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_MAX_MODEL_LEN=3200
VLLM_GPU_MEM_UTIL=0.90

OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MEMORY_LIMIT=6G
OLLAMA_CPU_LIMIT=4

# HuggingFace token — required by vLLM (GPU mode) to download model weights.
# Not needed for Ollama (CPU mode). Create a read-only token at huggingface.co/settings/tokens
HF_TOKEN=CHANGE_ME_hf_token

# ── LLM analysis service ───────────────────────────────────────────────────────
# Credentials for the /api/v1/chat endpoint (separate from Caddy admin auth).
ANALYSIS_AUTH_USER=analyst
ANALYSIS_AUTH_PASSWORD=CHANGE_ME_strong_password_here

# Internal service URLs (container-to-container, do not change unless renaming services).
VLLM_URL=http://vllm:8000
DETECTION_URL=http://detection:8081
ML_INFER_URL=http://ml-infer:8080
MOMENT_URL=http://moment-sidecar:8083
CHRONOS_URL=http://chronos-sidecar:8084
ANALYSIS_URL=http://analysis:8082
# MODEL_VARIANT: MOMENT-1-large (default, ~3.5GB) or MOMENT-1-base (~1.5GB, less accurate)
MOMENT_VARIANT=MOMENT-1-large

# PromQL query limits enforced by the validator before any query reaches VM.
MAX_QUERY_RANGE=720h   # 30 days
MIN_STEP=15s

# How often to refresh the metric name allowlist from VictoriaMetrics.
ALLOWLIST_REFRESH_INTERVAL=5m

# Chat session inactivity timeout (in-memory, resets on container restart).
SESSION_TTL=30m

# ── UPF simulator ──────────────────────────────────────────────────────────────
# URL used by the analysis service to trigger scenarios on upf-sim.
# Only relevant when running dev/docker-compose.yml. Safe to leave as-is for production.
SIM_URL=http://upf-sim:8090

# Scenario engine settings (all optional — defaults are shown).
SIM_NODE_ID=sim-upf-01
SIM_BASE_SESSIONS=1000000      # midpoint session count; 10 lakhs = carrier-grade UPF
SIM_BYTES_PER_SESSION=5000     # bytes/s per session → 6 GB/s baseline N3 rx, 24 GB/s at 4× spike
SIM_SPIKE_MULTIPLIER=4.0       # session_spike maximum multiplier over baseline
SIM_RAMP_SECONDS=120           # seconds to ramp from 1x to SpikeMultiplier in spike mode
# To enable automated scenario cycling, set:
# SEQUENCE_FILE=/config/scenarios.yml
# -- Grafana --------------------------------------------------------------------
# Admin credentials for the Grafana UI (accessible at /grafana/).
# Grafana has its own login page � these are NOT the same as CADDY_ADMIN_USER.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# Internal URL (used by Grafana to reach VictoriaMetrics via provisioning).
# Do not change unless renaming the victoriametrics service.
# VM_AUTH_USERNAME and VM_AUTH_PASSWORD above are reused by Grafana datasource.

# ── Temporal intelligence sidecar (STL decomposition) ─────────────────────────
# Internal URL of the STL sidecar — analysis service uses this for regime context
# and calendar injection into Brain 2 RCA prompts.
STL_URL=http://stl-sidecar:8085

# Holiday calendar country code (ISO 3166-1 alpha-2).
# Default: IN (India). Change to your country for correct public holiday awareness.
HOLIDAY_COUNTRY=IN

# Optional province/state subdivision code (e.g. "DL" for Delhi, "MH" for Maharashtra).
# Leave blank for national-level holidays only.
HOLIDAY_SUBDIVISION=
