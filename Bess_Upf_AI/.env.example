# BESS-UPF v2 (Kubernetes/Helm stack) — local config.
#
# Copy to .env and fill in what you want to change; install.py reads .env
# automatically on every run and applies each set value via `helm --set`
# (see ENV_TO_HELM in install.py). Anything you leave blank/commented falls
# back to the chart's own values.yaml defaults — .env never needs to be
# complete.
#
# .env is gitignored — never commit real credentials.

# ── GHCR image pull ──────────────────────────────────────────────────────────
# Only matters for a genuine registry pull. Local kind images are built and
# `kind load`-ed directly, so the defaults (local-dev/unused) are fine as-is.
GHCR_USERNAME=local-dev
GHCR_TOKEN=unused

# ── HuggingFace token ─────────────────────────────────────────────────────────
# Only used when analysis.vllm.mock.enabled=false (real GPU vLLM mode).
# Ignored (mock vLLM needs no token) while mock mode is on, which is the
# local-dev default. Create a read-only token at huggingface.co/settings/tokens
HF_TOKEN=

# ── Ingress ───────────────────────────────────────────────────────────────────
# Hostname used in the Ingress TLS cert / host matching.
INGRESS_HOST=bess-upf.local

# ── analysis: chat/API auth ───────────────────────────────────────────────────
# Gates every /api/v1/* route (chat, anomalies, scenario, etc.).
ANALYSIS_AUTH_USER=admin
ANALYSIS_AUTH_PASSWORD=bess_admin

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Leave blank to auto-generate a secure random password on first install
# (persisted across upgrades). Set explicitly here to pin it to a known value.
CLICKHOUSE_PASSWORD=

# ── Internal service URLs ─────────────────────────────────────────────────────
# Cluster-DNS addresses — only change these if you rename the matching
# Kubernetes Service, or point at something outside the cluster.
VLLM_URL=http://vllm:8000
SIM_URL=http://upf-sim:8090
RAY_SERVE_URL=http://serve:8000
CHRONOS_URL=http://chronos:8084
KAFKA_BROKER=redpanda:9092

# UPF metrics scrape target — swap to a real UPF's /metrics endpoint to stop
# using upf-sim as the data source.
UPF_SIM_METRICS_URL=http://upf-sim:8090/metrics

# ── Ports ──────────────────────────────────────────────────────────────────────
# mitigation's own app reads $API_PORT, so this one is safe to change
# end-to-end (containerPort + Service + Ingress route all follow it).
MITIGATION_API_PORT=8081

# ── Intervals ──────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_SECS=1.0
FORECAST_CHECK_INTERVAL_SECS=60
CHRONOS_STEP_SECONDS=60
