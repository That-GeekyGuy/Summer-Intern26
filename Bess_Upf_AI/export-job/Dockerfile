# ── Stage 1: Build the Go binary ─────────────────────────────────────────────
FROM golang:1.22-alpine AS builder

WORKDIR /build

# Copy source first so go mod tidy can analyse imports.
# NOTE: go.sum is generated by 'go mod tidy'. Commit it to source control for
# reproducible CI builds. On first clone, the Dockerfile generates it here.
COPY . .

RUN go mod tidy && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /usr/local/bin/upf-exporter .

# ── Stage 2: Fetch supercronic ────────────────────────────────────────────────
FROM alpine:3.19 AS supercronic-fetcher

ARG SUPERCRONIC_VERSION=v0.2.33
ARG SUPERCRONIC_ARCH=amd64

# TODO: pin SUPERCRONIC_SHA1SUM for supply-chain security.
# After downloading, run: sha1sum /usr/local/bin/supercronic
# Then add: && echo "<hash>  /usr/local/bin/supercronic" | sha1sum -c -
RUN apk add --no-cache wget && \
    wget -qO /usr/local/bin/supercronic \
        "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${SUPERCRONIC_ARCH}" && \
    chmod +x /usr/local/bin/supercronic

# ── Stage 3: Minimal runtime image ───────────────────────────────────────────
FROM alpine:3.19

# Non-root user for the export job.
RUN addgroup -S exporter && adduser -S -G exporter exporter

COPY --from=builder         /usr/local/bin/upf-exporter  /usr/local/bin/upf-exporter
COPY --from=supercronic-fetcher /usr/local/bin/supercronic /usr/local/bin/supercronic

# crontab is bind-mounted at runtime from config/export/crontab.
RUN mkdir -p /etc/supercronic && chown exporter:exporter /etc/supercronic

USER exporter

# supercronic reads the crontab and runs upf-exporter on schedule.
# To run a one-shot export immediately (useful for testing):
#   docker compose run --rm export-job /usr/local/bin/upf-exporter
ENTRYPOINT ["/usr/local/bin/supercronic", "/etc/supercronic/crontab"]
