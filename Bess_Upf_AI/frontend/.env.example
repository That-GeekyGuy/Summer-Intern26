# API base URL — leave empty to use relative paths (proxied via vite dev server / nginx)
VITE_API_BASE=

# Polling intervals (milliseconds)
VITE_POLL_ANOMALIES_MS=15000   # How often to refresh anomaly feed
VITE_POLL_PULSE_MS=5000        # How often to update the pulse strip (uses LLM call!)
VITE_POLL_HEALTH_MS=30000      # How often to check service health
VITE_POLL_FORECAST_MS=60000    # How often to refresh forecast data

# Set to "true" to enable scenario control view (dev/demo only)
# Leave empty or set to "false" for production builds
VITE_ENABLE_SCENARIO_CONTROLS=true
