    { "id": 13, "type": "timeseries",
      "title": "Throughput — TCP vs UDP  (handled/s · rejected/s)",
      "description": "UDP handled/s significantly exceeds TCP due to no per-packet handshake. Dashed lines = rejected (queue full).",
      "gridPos": { "x": 0, "y": 6, "w": 14, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(tcp_connections_total[30s])",
          "legendFormat": "TCP handled/s" },
        { "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(udp_packets_total[30s])",
          "legendFormat": "UDP handled/s" },
        { "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(tcp_connections_rejected_total[30s])",
          "legendFormat": "TCP rejected/s" },
        { "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(udp_packets_rejected_total[30s])",
          "legendFormat": "UDP rejected/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TCP handled/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP handled/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "TCP rejected/s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "dark-blue", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]},
          { "matcher": { "id": "byName", "options": "UDP rejected/s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } }
            ]}
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },

