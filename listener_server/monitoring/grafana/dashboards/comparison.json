{
  "uid": "tcp-udp-comparison",
  "title": "TCP · UDP · QUIC — Protocol Benchmark",
  "description": "Live comparison of TCP, UDP, and QUIC listener throughput, latency percentiles (p50/p95/p99), resource usage, and chaos injection. Use the Rate window variable to adjust smoothing.",
  "schemaVersion": 38,
  "version": 3,
  "refresh": "5s",
  "time": { "from": "now-10m", "to": "now" },
  "timezone": "browser",
  "tags": ["tcp", "udp", "quic", "comparison", "latency", "chaos"],
  "annotations": { "list": [] },
  "links": [],

  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "30s", "value": "30s" },
        "hide": 0,
        "includeAll": false,
        "label": "Rate window",
        "multi": false,
        "name": "window",
        "options": [
          { "selected": false, "text": "5s",  "value": "5s"  },
          { "selected": false, "text": "15s", "value": "15s" },
          { "selected": true,  "text": "30s", "value": "30s" },
          { "selected": false, "text": "60s", "value": "60s" },
          { "selected": false, "text": "2m",  "value": "2m"  }
        ],
        "query": "5s,15s,30s,60s,2m",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },

  "panels": [

    { "id": 1, "type": "stat",
      "title": "TCP — Throughput",
      "description": "Connections handled per second. Limited by kernel TCP handshake rate × pool workers.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rate(tcp_connections_total[$window])",
        "legendFormat": "TCP" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0, "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 2, "type": "stat",
      "title": "UDP — Throughput",
      "description": "Datagrams handled per second. No per-packet handshake; ceiling is the single ReadFromUDP goroutine rate.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rate(udp_packets_total[$window])",
        "legendFormat": "UDP" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0, "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 3, "type": "stat",
      "title": "QUIC — Throughput",
      "description": "Streams handled per second. QUIC reuses connections — opening a stream costs ~1µs vs TCP's ~100µs 3-way handshake.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rate(quic_streams_total[$window])",
        "legendFormat": "QUIC" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0, "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 4, "type": "stat",
      "title": "TCP — p99 Latency",
      "description": "99th-percentile handler duration. The worst 1% of requests — invisible in averages, very visible to users.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(histogram_quantile(0.99, rate(tcp_request_duration_ms_bucket[$window])) > 0) or vector(0)",
        "legendFormat": "TCP p99" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0, "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 100 }
          ]}
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 5, "type": "stat",
      "title": "UDP — p99 Latency",
      "description": "99th-percentile handler duration for UDP datagrams.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(histogram_quantile(0.99, rate(udp_request_duration_ms_bucket[$window])) > 0) or vector(0)",
        "legendFormat": "UDP p99" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0, "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "orange", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 50 }
          ]}
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 6, "type": "stat",
      "title": "QUIC — p99 Latency",
      "description": "99th-percentile handler duration for QUIC streams.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(histogram_quantile(0.99, rate(quic_request_duration_ms_bucket[$window])) > 0) or vector(0)",
        "legendFormat": "QUIC p99" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0, "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red", "value": 50 }
          ]}
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 7, "type": "timeseries",
      "title": "Throughput — handled/s and rejected/s (all protocols)",
      "description": "Solid lines = successfully handled. Dashed lines = rejected (pool full / SERVER_BUSY). UDP is faster because it skips per-datagram TCP handshakes. QUIC reuses connections so stream-open cost is near zero.",
      "gridPos": { "x": 0, "y": 4, "w": 18, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(tcp_connections_total[$window])", "legendFormat": "TCP handled/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(udp_packets_total[$window])", "legendFormat": "UDP handled/s" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(quic_streams_total[$window])", "legendFormat": "QUIC handled/s" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(tcp_connections_rejected_total[$window])", "legendFormat": "TCP rejected/s" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(udp_packets_rejected_total[$window])", "legendFormat": "UDP rejected/s" },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(quic_streams_rejected_total[$window])", "legendFormat": "QUIC rejected/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TCP handled/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP handled/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "QUIC handled/s" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "TCP rejected/s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "dark-blue", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]},
          { "matcher": { "id": "byName", "options": "UDP rejected/s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]},
          { "matcher": { "id": "byName", "options": "QUIC rejected/s" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "dark-green", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]}
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }
      }
    },

    { "id": 8, "type": "stat",
      "title": "UDP / TCP speedup",
      "description": "How many times faster UDP is than TCP right now. Should be 10–50× at the same worker count due to no per-packet handshake.",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(rate(udp_packets_total[$window]) / rate(tcp_connections_total[$window]) >= 0) or vector(0)",
        "legendFormat": "UDP / TCP" }],
      "fieldConfig": {
        "defaults": {
          "unit": "x", "min": 0, "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue",   "value": null },
            { "color": "green",  "value": 5    },
            { "color": "yellow", "value": 20   },
            { "color": "orange", "value": 50   }
          ]}
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 9, "type": "stat",
      "title": "QUIC / TCP speedup",
      "description": "QUIC streams vs TCP connections per second. QUIC avoids per-connection TLS handshake — only pays it once per long-lived connection.",
      "gridPos": { "x": 18, "y": 9, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "(rate(quic_streams_total[$window]) / rate(tcp_connections_total[$window]) >= 0) or vector(0)",
        "legendFormat": "QUIC / TCP" }],
      "fieldConfig": {
        "defaults": {
          "unit": "x", "min": 0, "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue",   "value": null },
            { "color": "green",  "value": 5    },
            { "color": "yellow", "value": 20   },
            { "color": "orange", "value": 50   }
          ]}
        }, "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "value_and_name",
        "colorMode": "background", "graphMode": "area", "justifyMode": "auto"
      }
    },

    { "id": 10, "type": "row",
      "title": "Resources — CPU · Memory · Goroutines",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },

    { "id": 11, "type": "timeseries",
      "title": "CPU %",
      "description": "TCP spends CPU on kernel handshake work (SYN/ACK processing). UDP spends it on syscall volume. QUIC pays TLS 1.3 crypto once per connection then runs streams cheaply.",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(tcp_process_cpu_seconds_total[$window]) * 100", "legendFormat": "TCP" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(udp_process_cpu_seconds_total[$window]) * 100", "legendFormat": "UDP" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(quic_process_cpu_seconds_total[$window]) * 100", "legendFormat": "QUIC" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 12, "spanNulls": false, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TCP" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "QUIC" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },

    { "id": 12, "type": "timeseries",
      "title": "Memory (RSS)",
      "description": "Resident Set Size — physical RAM. TCP holds kernel connection state per active connection. UDP has one shared socket. QUIC holds TLS session state per connection.",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tcp_process_rss_bytes", "legendFormat": "TCP RSS" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tcp_process_heap_alloc_bytes", "legendFormat": "TCP Heap" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "udp_process_rss_bytes", "legendFormat": "UDP RSS" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "udp_process_heap_alloc_bytes", "legendFormat": "UDP Heap" },
        { "refId": "E", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "quic_process_rss_bytes", "legendFormat": "QUIC RSS" },
        { "refId": "F", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "quic_process_heap_alloc_bytes", "legendFormat": "QUIC Heap" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TCP RSS" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "TCP Heap" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "light-blue", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } }
            ]},
          { "matcher": { "id": "byName", "options": "UDP RSS" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP Heap" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } }
            ]},
          { "matcher": { "id": "byName", "options": "QUIC RSS" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "QUIC Heap" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "light-green", "mode": "fixed" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 4] } }
            ]}
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },

    { "id": 13, "type": "timeseries",
      "title": "Goroutines",
      "description": "In unbounded mode (WORKER_POOL_SIZE=0), TCP spawns a goroutine per connection — watch it spike under load. UDP and QUIC use a fixed dispatch loop; goroutine count stays flat.",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "tcp_process_goroutines", "legendFormat": "TCP" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "udp_process_goroutines", "legendFormat": "UDP" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "quic_process_goroutines", "legendFormat": "QUIC" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 12, "spanNulls": false, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TCP" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "QUIC" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },

    { "id": 14, "type": "row",
      "title": "Latency Percentiles — p50 · p95 · p99",
      "description": "Uses histogram_quantile() over bucket counters. Set HANDLER_DELAY_MS > 0 or send load to see non-trivial values. Chaos jitter will visibly inflate p99.",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "collapsed": false
    },

    { "id": 15, "type": "timeseries",
      "title": "p50 — Median latency",
      "description": "Half of all requests finish faster than this. Shows 0ms when idle (no traffic). Set HANDLER_DELAY_MS > 0 or send load via /run endpoint to see non-zero values.",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(histogram_quantile(0.50, rate(tcp_request_duration_ms_bucket[$window])) > 0) or vector(0)",
          "legendFormat": "TCP" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(histogram_quantile(0.50, rate(udp_request_duration_ms_bucket[$window])) > 0) or vector(0)",
          "legendFormat": "UDP" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(histogram_quantile(0.50, rate(quic_request_duration_ms_bucket[$window])) > 0) or vector(0)",
          "legendFormat": "QUIC" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "spanNulls": false, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "TCP" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "QUIC" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "options": {
