{
  "uid": "tcp-udp-comparison",
  "title": "TCP vs UDP — Live Comparison",
  "description": "Side-by-side throughput, CPU, RAM, and rejection rates for TCP and UDP listeners",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-10m", "to": "now" },
  "timezone": "browser",
  "tags": ["tcp", "udp", "comparison"],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [],

  "panels": [

    { "id": 1, "type": "stat", "title": "TCP — CPU %",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "refId": "A",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "expr": "rate(tcp_process_cpu_seconds_total[30s]) * 100",
        "legendFormat": "TCP CPU %",
        "instant": false
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "blue", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 80 }
          ]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto", "textMode": "auto",
        "colorMode": "background", "graphMode": "none", "justifyMode": "auto"
      }
    },

